{
  "manifest_version": 3,
  "name": "ChatGPT Conversation Timeline（本地修复）",
  "version": "3.3.1",
  "description": "Local compatibility fix for ChatGPT conversation navigation.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "会话时间轴"
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "chatgpt-initial-jump-utils.js",
        "content-chatgpt.js"
      ],
      "css": [
        "styles-chatgpt.css"
      ]
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "fiber-bridge-chatgpt.js"
      ],
      "world": "MAIN"
    }
  ],
  "version_name": "3.3.1-local.20261016"
}
